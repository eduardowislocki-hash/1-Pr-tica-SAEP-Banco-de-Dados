create or replace function fn_buscar_colaboradores(termo_busca text)
returns table (
    id_colaborador int,
    nome varchar(120),
    email varchar(150),
    ativo boolean
)
as $$
begin
    return query
    select c.id_colaborador, c.nome, c.email, c.ativo
    from colaboradores c
    where c.nome ilike '%' || termo_busca || '%'
    or c.email ilike '%' || termo_busca || '%';
end;
$$ language plpgsql;

create or replace view vw_painel_principal as
select
    c.nome as colaborador,
    t.titulo as tarefa,
    cat.nome as categoria,
    t.prazo_entrega,
    t.status
from tarefas t
join colaboradores c on t.id_colaborador = c.id_colaborador
join categorias cat on t.id_categoria = cat.id_categoria;

create or replace view vw_cronograma_prazos as
select
    t.id_tarefa,
    t.titulo as tarefa,
    t.status,
    t.data_agendamento,
    t.prazo_entrega,
    t.prazo_entrega - current_date as dias_restantes,
    c.nome as responsavel
from tarefas t
join colaboradores c on t.id_colaborador = c.id_colaborador
order by t.prazo_entrega asc;

