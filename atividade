
create table departamentos (
    id_departamento serial primary key,
    nome varchar(100) not null unique,
    descricao text
);

create table colaboradores (
    id_colaborador serial primary key,
    id_departamento int not null references departamentos(id_departamento),
    nome varchar(120) not null,
    email varchar(150) not null unique,
    senha text not null,
    ativo boolean not null default true
);

create table categorias (
    id_categoria serial primary key,
    nome varchar(100) not null unique,
    descricao text
);

create table projetos (
    id_projeto serial primary key,
    id_colaborador int not null references colaboradores(id_colaborador),
    nome varchar(150) not null,
    descricao text,
    data_inicio date not null,
    data_fim date not null,
    status varchar(30) not null default 'planejado',
    check (data_fim >= data_inicio),
    check (status in ('planejado', 'em andamento', 'concluido', 'cancelado'))
);

create table tarefas (
    id_tarefa serial primary key,
    id_projeto int not null references projetos(id_projeto),
    id_colaborador int not null references colaboradores(id_colaborador),
    id_categoria int not null references categorias(id_categoria),
    titulo varchar(150) not null,
    descricao text,
    data_agendamento date not null,
    prazo_entrega date not null,
    data_criacao timestamp,
    status varchar(30) not null default 'pendente',
    check (prazo_entrega >= data_agendamento),
    check (status in ('pendente', 'em andamento', 'concluida', 'atrasada'))
);

create table historico_tarefas (
    id_historico serial primary key,
    id_tarefa int not null references tarefas(id_tarefa),
    descricao text not null,
    data_registro timestamp not null default current_timestamp
);

create table comentarios (
    id_comentario serial primary key,
    id_tarefa int not null references tarefas(id_tarefa),
    id_colaborador int not null references colaboradores(id_colaborador),
    comentario text not null,
    data_comentario timestamp default current_timestamp
);

