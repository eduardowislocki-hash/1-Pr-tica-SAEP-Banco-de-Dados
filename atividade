create or replace function fn_validar_tarefa()
returns trigger as $$
begin
    if not exists (
        select 1
        from colaboradores
        where id_colaborador = new.id_colaborador
        and ativo = true
    ) then
        raise exception 'o colaborador precisa estar ativo';
    end if;

    new.data_criacao = current_timestamp;

    return new;
end;
$$ language plpgsql;

create or replace function fn_registrar_historico()
returns trigger as $$
begin
    insert into historico_tarefas (id_tarefa, descricao)
    values (new.id_tarefa, 'tarefa criada: ' || new.titulo);

    return new;
end;
$$ language plpgsql;

create trigger trg_validar_tarefa
before insert on tarefas
for each row
execute function fn_validar_tarefa();

create trigger trg_historico_tarefa
after insert on tarefas
for each row
execute function fn_registrar_historico();

